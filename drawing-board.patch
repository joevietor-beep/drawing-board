-import { invoke } from "@tauri-apps/api/core";
+import "./styles.css";
+import risingEntrepreneur from "./assets/rising-entrepreneur.png";
 
-let greetInputEl: HTMLInputElement | null;
-let greetMsgEl: HTMLElement | null;
+type Space = "sanctuary" | "boardroom" | "studio";
 
-async function greet() {
-  if (greetMsgEl && greetInputEl) {
-    // Learn more about Tauri commands at https://tauri.app/develop/calling-rust/
-    greetMsgEl.textContent = await invoke("greet", {
-      name: greetInputEl.value,
-    });
-  }
-}
+const rooms: Record<Space, { title: string; lead: string; tools: string[] }> = {
+  sanctuary: {
+    title: "Begin with awareness.",
+    lead: "A quiet place to arrive before the work begins.",
+    tools: ["Morning Meditation", "Journal", "Constitution"],
+  },
+  boardroom: {
+    title: "Make the important moves visible.",
+    lead: "A clear room for commitments, conversations, and the work in motion.",
+    tools: ["Today's Focus", "DealDocs", "Prospect Radar", "Analytics", "Projects"],
+  },
+  studio: {
+    title: "Turn the work into something shareable.",
+    lead: "A focused collection of creative tools and working surfaces.",
+    tools: ["Article Architect", "Social Vibe", "Image Roll", "Video Edits", "Plan Notes"],
+  },
+};
 
-window.addEventListener("DOMContentLoaded", () => {
-  greetInputEl = document.querySelector("#greet-input");
-  greetMsgEl = document.querySelector("#greet-msg");
-  document.querySelector("#greet-form")?.addEventListener("submit", (e) => {
-    e.preventDefault();
-    greet();
-  });
-});
+const details: Record<string, string> = {
+  "Today's Focus": "Must Do · Waiting On · Wins",
+  DealDocs: "Recent conversations · Follow-ups · Pipeline",
+  "Prospect Radar": "Yellow Pages · Apollo · LinkedIn · Lead imports",
+  Analytics: "Calls made · Response rate · Website traffic · Revenue trends",
+  Projects: "WordPress sites · Client work · Internal development",
+  "Article Architect": "Long-form writing.",
+  "Social Vibe": "Facebook · LinkedIn · Instagram · X",
+  "Image Roll": "Prompt library · Editorial images · Hero graphics",
+  "Video Edits": "Shotcut · DaVinci · Captions · Shorts",
+  "Plan Notes": "Whiteboard · Brainstorming · Mind maps · Meeting notes",
+  Journal: "Make space for what is present and what matters today.",
+  Constitution: "Return to the principles that hold the work together.",
+};
+
+let space: Space | null = null;
+let tool: string | null = null;
+let meditationStep = 0;
+
+const app = document.querySelector<HTMLDivElement>("#app")!;
+
+function shell(content: string) {
+  return `<div class="app-shell">
+    <header class="topbar">
+      <button class="brand" data-home><b>DB</b> Drawing Board</button>
+      <span>${space ? rooms[space].title : "A deliberate workspace"}</span>
+      <button class="quiet-button" data-meditation>Morning meditation ↗</button>
+    </header>${content}</div>`;
+}
+
+function home() {
+  return shell(`<main class="home">
+    <p class="eyebrow">One chapter. One room. One careful stone at a time.</p>
+    <h1>A place to see the whole of your work.</h1>
+    <p class="lead">Enter through the room that serves this moment.</p>
+    <section class="cards">
+      <button class="room sanctuary" data-space="sanctuary">
+        <img src="${risingEntrepreneur}" alt="Sunrise landscape" />
+        <span><small>Sanctuary</small><strong>Begin with awareness.</strong><em>Meditation · Journal · Constitution</em></span>
+      </button>
+      <button class="room boardroom" data-space="boardroom">
+        <span><small>Board Room</small><strong>Bring the day into focus.</strong><em>Priorities · Pipeline · Projects</em></span>
+      </button>
+      <button class="room studio" data-space="studio">
+        <span><small>Studio</small><strong>Make something useful.</strong><em>Writing · Images · Video · Notes</em></span>
+      </button>
+    </section>
+  </main>`);
+}
+
+function roomView() {
+  const room = rooms[space!];
+  return shell(`<main class="page">
+    <button class="back" data-home>← All rooms</button>
+    <p class="eyebrow">${space}</p><h1>${room.title}</h1><p class="lead">${room.lead}</p>
+    <section class="tools">${room.tools.map((item, index) => `
+      <button class="tool" data-tool="${item}">
+        <small>0${index + 1}</small><strong>${item}</strong>
+        <span>${details[item] ?? "A guided moment to settle and choose your intention."}</span><i>↗</i>
+      </button>`).join("")}
+    </section>
+  </main>`);
+}
+
+function meditation() {
+  const steps = [
+    ["Arrive", "Let the day wait at the door. Notice where you are."],
+    ["Breathe", "Take three unhurried breaths. There is nothing to solve yet."],
+    ["Notice", "What is asking for your attention beneath the noise?"],
+    ["Intend", "Name one way you want to show up in the next chapter."],
+  ];
+  const [title, copy] = steps[meditationStep];
+  return shell(`<main class="meditation">
+    <img src="${risingEntrepreneur}" alt="" /><div class="wash"></div>
+    <button class="close" data-close>Close</button>
+    <section class="meditation-card">
+      <p class="eyebrow">Morning meditation · ${meditationStep + 1} of 4</p>
+      <h1>${title}</h1><p>${copy}</p>
+      <div class="progress"><span style="width:${(meditationStep + 1) * 25}%"></span></div>
+      <div><button class="text-button" data-previous ${meditationStep === 0 ? "disabled" : ""}>Back</button>
+      <button class="continue" data-next>${meditationStep === 3 ? "Complete" : "Continue"} →</button></div>
+    </section>
+  </main>`);
+}
+
+function placeholder() {
+  return shell(`<main class="page placeholder">
+    <button class="back" data-close>← ${space}</button>
+    <div><p class="eyebrow">Workspace</p><h1>${tool}</h1>
+    <p class="lead">${details[tool!] ?? "This workspace is ready for its first real connection."}</p>
+    <hr /><p>This is a focused placeholder in the broad-strokes release. Its dedicated workflow and outside connections can be added one tool at a time.</p></div>
+  </main>`);
+}
+
+function render() {
+  app.innerHTML = tool === "Morning Meditation" ? meditation() : tool ? placeholder() : space ? roomView() : home();
+  app.querySelectorAll<HTMLElement>("[data-space]").forEach(el => el.onclick = () => { space = el.dataset.space as Space; render(); });
+  app.querySelectorAll<HTMLElement>("[data-tool]").forEach(el => el.onclick = () => { tool = el.dataset.tool!; render(); });
+  app.querySelector<HTMLElement>("[data-home]")?.addEventListener("click", () => { space = null; tool = null; render(); });
+  app.querySelector<HTMLElement>("[data-meditation]")?.addEventListener("click", () => { space = "sanctuary"; tool = "Morning Meditation"; meditationStep = 0; render(); });
+  app.querySelector<HTMLElement>("[data-close]")?.addEventListener("click", () => { tool = null; render(); });
+  app.querySelector<HTMLElement>("[data-next]")?.addEventListener("click", () => { meditationStep = (meditationStep + 1) % 4; if (!meditationStep) tool = null; render(); });
+  app.querySelector<HTMLElement>("[data-previous]")?.addEventListener("click", () => { meditationStep = Math.max(0, meditationStep - 1); render(); });
+}
+
+render();
